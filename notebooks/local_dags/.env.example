# =============================================================================
# DSRP ML Pipeline - Environment Variables
# =============================================================================
# Copy this file to .env and source it before running:
#   cp .env.example .env
#   source .env
# =============================================================================

# Data directory (default: ../data relative to dags/)
DSRP_DATA_DIR=

# OMDB API Key (required for data collection)
# Get your key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Qdrant (required for embeddings indexing)
DSRP_QDRANT_URL=http://localhost:6333
DSRP_QDRANT_COLLECTION=imdb-movies-hybrid

# Ollama (required for synthetic queries with LLM)
DSRP_OLLAMA_URL=http://localhost:11434/api/generate
DSRP_OLLAMA_MODEL=llama3.2:3b

# Embedding model
DSRP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MLflow Tracking (optional)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=DSRP-LTR-Pipeline

# Azure Storage (optional, for cloud data sync)
AZURE_STORAGE_CONNECTION_STRING=

# Airflow UID (only needed for Docker setup)
AIRFLOW_UID=50000
